# Contoh nama rahsia (JANGAN isi nilai sebenar di sini; masukkan di Vercel → Settings → Environment Variables)
MARKAS_AGENT_KEY=
MARKAS_VIEW_CODE=
# Untuk jadual Nadi (Vercel Cron hantar header Authorization: Bearer <CRON_SECRET>):
CRON_SECRET=
# Diisi automatik oleh Vercel bila Upstash disambung:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Telegram Bot (percuma, pilihan): token dari @BotFather + Chat ID Danial (bot beri bila tekan Start)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_DANIAL=
# Pilihan: rahsia webhook (kalau kosong, dikira dari token)
TELEGRAM_WEBHOOK_SECRET=
